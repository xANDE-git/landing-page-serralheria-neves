// Configuração do Cloudflare para publicar o site.
// O Cloudflare lê este arquivo a cada push na branch main.
// Documentação: https://developers.cloudflare.com/workers/static-assets/
{
  // Nome do projeto no Cloudflare. NÃO mude: é o que liga este repositório ao site publicado.
  "name": "serralheria-neves",
  // Data de referência das regras do Cloudflare (não precisa atualizar).
  "compatibility_date": "2026-11-04",
  "assets": {
    // Pasta com os arquivos do site: a própria raiz do projeto.
    // Arquivos que não devem ficar públicos estão listados em .assetsignore.
    "directory": ".",
    // Endereço que não existe mostra a página 404.html (com o status de erro correto).
    "not_found_handling": "404-page"
  }
}
